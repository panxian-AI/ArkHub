{
  "name": "dsh-arkhub",
  "version": "0.6.3",
  "description": "把 DSH 里的角色接上 QQ：ArkLink 通道插件，走她原来的会话，不另起一个进程。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qq",
    "onebot",
    "arklink"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-arkhub": "./bin/dsh-arkhub.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "tools"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": false
    }
  },
  "scripts": {
    "test": "node --test test/text.test.js test/update.test.js test/install.test.js test/onebot.test.js test/switch.test.js test/channel.test.js test/lines.test.js test/snowluma.test.js test/manual.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panxian-AI/ArkHub.git"
  }
}
